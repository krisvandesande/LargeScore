    "This MusicXML file has no parts to show.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit MusicXML-bestand heeft geen partijen om te tonen."
          }
        }
      }
    },
    "This MusicXML is written bar by bar instead of part by part. Export it again as a standard MusicXML file.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze MusicXML is per maat geschreven in plaats van per partij. Exporteer het opnieuw als standaard MusicXML-bestand."
          }
        }
      }
    },
    "This bar can't be changed that way.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze maat kan zo niet veranderd worden."
          }
        }
      }
    },
    "This bar has no note to put a fermata on.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze maat heeft geen noot voor een fermate."
          }
        }
      }
    },
    "This compressed MusicXML file can't be opened. Export it again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gecomprimeerde MusicXML-bestand kan niet worden geopend. Exporteer het opnieuw."
          }
        }
      }
    },
    "This file couldn't be opened. Check that it has finished downloading, then add it again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand kon niet geopend worden. Controleer of het helemaal gedownload is en voeg het opnieuw toe."
          }
        }
      }
    },
    "This is a PDF. Large Score reads MusicXML: convert the PDF on the Mac first, or add it together with its MusicXML.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een pdf. Large Score leest MusicXML: zet de pdf eerst om op de Mac, of voeg hem samen met zijn MusicXML toe."
          }
        }
      }
    },
    "This isn't a MusicXML file.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is geen MusicXML-bestand."
          }
        }
      }
    },
    "This music could not be read.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze muziek kon niet worden gelezen."
