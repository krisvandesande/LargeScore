    "This version has %lld bars instead of %lld. Check your notes: after the change they may sit on other bars.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This version has %1$lld bars instead of %2$lld. Check your notes: after the change they may sit on other bars."
