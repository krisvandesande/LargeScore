    },
    "%@ is in the Large Score folder in iCloud Drive. Choose that folder in Large Score's Settings, Music Folder, to add it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ staat in de map Large Score in iCloud Drive. Kies die map in Large Score bij Instellingen, Muziekmap, om het toe te voegen."
          }
        }
      }
    },
    "%@ is in the library. The iPad shows it within a minute.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
